  "scripts": {
    "dev": "vite",
    "prebuild": "yarn validate",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.json",
    "validate": "node scripts/validate-data.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs}\""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "daisyui": "^5.7.38",
    "postcss": "^8.3.11",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
